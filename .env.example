# Telegram Bot Token (BotFather'dan olingan token)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Server porti (Render avtomatik ravishda tayinlaydi)
PORT=3000

# Render Webhook sozlamalari (Ixtiyoriy - agar Webhook ishlatilsa)
# WEBHOOK_URL=https://your-app-name.onrender.com

# Ishga tushirish rejimi: production yoki development
NODE_ENV=production
